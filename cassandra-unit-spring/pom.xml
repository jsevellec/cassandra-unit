<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.cassandraunit</groupId>
		<artifactId>cassandra-unit-parent</artifactId>
        <version>5.3.0</version>
	</parent>
    <groupId>org.cassandraunit</groupId>
	<artifactId>cassandra-unit-spring</artifactId>
	<packaging>jar</packaging>
	<name>cassandra-unit-spring</name>
	<description>Spring Test framework to develop with Cassandra</description>

	<dependencies>
        <dependency>
            <groupId>org.cassandraunit</groupId>
            <artifactId>cassandra-unit</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          Spring is `provided`: the consuming application owns the Spring version. Compiling
          against 6.2.x is deliberate - every spring-test API this module uses
          (TestExecutionListener, AbstractTestExecutionListener,
          DependencyInjectionTestExecutionListener.REINJECT_DEPENDENCIES_ATTRIBUTE) is still
          present in 7.0.x, so a 7.x consumer works unchanged. Earlier versions shipped Spring
          4.0.2.RELEASE at compile scope, which forced an EOL Spring onto every consumer.
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>${cu.spring.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <version>${cu.spring.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${cu.junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${cu.assertj.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
          Spring Boot, test scope only, so that the Boot story is actually proved rather than
          asserted: CassandraAutoConfiguration has to bind the spring.cassandra.* properties the
          context customizer publishes, and nothing short of running Boot demonstrates that.

          Deliberately four explicit artifacts rather than spring-boot-starter-test, and no BOM
          import. The starter brings its own JUnit, AssertJ and spring-test versions, and
          spring-boot-dependencies manages netty, jackson and snakeyaml - which would quietly
          override the netty-bom and jackson-bom pins the parent sets on purpose.

          CassandraAutoConfiguration is @ConditionalOnClass(CqlSession.class) and needs no
          spring-data-cassandra; java-driver-core is already here through cassandra-unit.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
            <version>${cu.spring.boot.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <version>${cu.spring.boot.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
          Boot 4 split the auto-configurations out of spring-boot-autoconfigure into one module per
          technology; CassandraAutoConfiguration lives here now. On Boot 3 it was in
          spring-boot-autoconfigure, which is why this coordinate looks new.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-cassandra</artifactId>
            <version>${cu.spring.boot.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test</artifactId>
            <version>${cu.spring.boot.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test-autoconfigure</artifactId>
            <version>${cu.spring.boot.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- log -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-core</artifactId>
            <version>${cu.logback.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${cu.logback.version}</version>
            <scope>test</scope>
        </dependency>

	</dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-jdk</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <!--
                                  Cassandra 5.0 runs on JDK 11 or 17 only, and the embedded
                                  daemon is started in this JVM, so the build JDK is the
                                  server JDK. We require 17 specifically: maven.compiler.release
                                  is 17, and spring-test needs 17 regardless, so supporting
                                  11 would mean split release levels across modules for no gain.
                                  Without this check a wrong JDK shows up as
                                  surefire's "The forked VM terminated without properly
                                  saying goodbye", which says nothing useful. Note that a
                                  jenv shim will override JAVA_HOME for mvn - check
                                  `mvn -v`, not `java -version`.

                                  The upper bound is real, not caution: Cassandra's
                                  ThreadAwareSecurityManager calls System::setSecurityManager,
                                  which is terminally deprecated and throws on JDK 24+.
                                -->
                                <requireJavaVersion>
                                    <version>[17,18)</version>
                                    <message>cassandra-unit must be built and run on JDK 17. Cassandra 5.0 supports only JDK 11 and 17, and this project targets 17 (spring-test requires it too). The embedded daemon runs in the build JVM, so this is the server JDK as well. If this looks wrong, check `mvn -v` - a jenv shim overrides JAVA_HOME for mvn.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              EmbeddedCassandraRandomPortSpringBootTest starts the node with
              cu-cassandra-rndport.yaml, and a JVM is pinned to the first Cassandra configuration it
              starts - checkConfigNameForRestart throws on a second. So it needs a fork to itself.

              The parent declares both executions already; what is overridden here is which tests
              each one matches. The parent's lists name tests that live in cassandra-unit, so in this
              module they match nothing and replacing them costs nothing.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <configuration>
                            <excludes>
                                <exclude>**/EmbeddedCassandraRandomPortSpringBootTest.java</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>isolated-config-tests</id>
                        <configuration>
                            <includes>
                                <include>**/EmbeddedCassandraRandomPortSpringBootTest.java</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
