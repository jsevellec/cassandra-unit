<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans   http://www.springframework.org/schema/beans/spring-beans.xsd
       					   http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd">
    
	<bean class="org.springframework.beans.factory.config.PropertyPlaceholderConfigurer">
        <property name="locations" value="classpath:props.properties" />
    </bean>
    
    <context:annotation-config />
	<!--
	  This scan exists to find ValueContainer, the @Component declared in the test class. It must
	  not pick up @Configuration classes: other tests in this package declare their own, some of
	  them defining a CqlSession bean, and scanning them in would build beans this context never
	  asked for. That is not hypothetical - it silently broke the context-reuse assertions in
	  EmbeddedCassandraContextReuseTest, which count how many times their shared configuration is
	  instantiated, and it depended on test ordering so it passed locally and failed in CI.
	-->
	<context:component-scan base-package="org.cassandraunit.spring">
		<context:exclude-filter type="annotation"
								expression="org.springframework.context.annotation.Configuration" />
	</context:component-scan>
</beans>